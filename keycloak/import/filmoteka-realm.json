{
  "realm": "filmoteka",
  "displayName": "Filmoteka",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": false,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 604800,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 7776000,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Default Filmoteka user"
      },
      {
        "name": "ADMIN",
        "description": "Filmoteka administrator"
      },
      {
        "name": "default-roles-filmoteka",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-filmoteka",
    "description": "${role_default-roles}",
    "composite": true
  },
  "clients": [
    {
      "clientId": "filmoteka-ui",
      "name": "Filmoteka UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "filmoteka-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "filmoteka-api"
          }
        }
      ]
    }
  ]
}